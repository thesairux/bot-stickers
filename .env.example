# ───────── Metadatos del sticker (lo que se ve al tocar el sticker) ─────────
STICKER_PACK_NAME=Bot Stickers
STICKER_AUTHOR=bot-stickers

# ───────── ¿Quién puede usar el bot? ─────────
# Si el bot corre en TU número: usa el chat "Mensaje para ti" (Tú) de WhatsApp.
RESPOND_IN_SELF_CHAT=true

# Si el bot corre en un número aparte: pon aquí tu número (con código de país,
# solo dígitos o como quieras escribirlo). Separa varios con comas.
# Ej: ALLOWED_NUMBERS=5215512345678,573001234567
ALLOWED_NUMBERS=

# Grupos donde el bot convierte todo lo que se mande. Usa !id en el grupo
# para saber su ID. Ej: ALLOWED_GROUPS=120363000000000000@g.us
ALLOWED_GROUPS=

# true = convierte TODO lo que le manden en privado, sin necesidad de comando.
# ⚠️ Si el bot está en tu número personal, cada foto que te manden tus amigos
# recibiría un sticker de vuelta. Mejor usa PUBLIC_COMMANDS.
ALLOW_EVERYONE=false

# true = cualquiera (en privado o en grupos) puede pedir un sticker escribiendo
# .sticker en el pie de una foto/video, respondiendo .sticker a una foto o
# enlace, o con ".sticker <enlace>". Tú también puedes usarlo en cualquier chat.
PUBLIC_COMMANDS=true
# Máximo de .sticker por minuto para cada persona que no está en tus listas
PUBLIC_RATE_LIMIT=5

# ───────── Conexión ─────────
# Vacío = te muestra un QR en la terminal.
# Si pones el número del bot (ej. 5215512345678) te da un código de 8 dígitos
# para vincular desde WhatsApp → Dispositivos vinculados → "Vincular con número".
PAIRING_NUMBER=
AUTH_DIR=auth_info

# Foto y descripción del perfil del bot. Se ponen al conectarse (solo cuando cambian).
# ⚠️ Si el bot corre en TU número personal, esto cambia TU perfil: déjalos vacíos
# (PROFILE_PICTURE= y PROFILE_STATUS=) para no tocarlo.
PROFILE_PICTURE=assets/profile.jpg
# Descripción ("Info") del perfil del bot. Máx. 139 caracteres. Vacío = no tocarla.
PROFILE_STATUS=stickers :D made by triton

# ───────── Límites ─────────
# Segundos máximos de video/GIF en el sticker animado
MAX_VIDEO_SECONDS=8
# Tamaño máximo de archivo a descargar (MB)
MAX_DOWNLOAD_MB=60
# Máximo de stickers por mensaje (un tweet puede traer hasta 4 fotos)
MAX_STICKERS_PER_MESSAGE=6
# Cuántas conversiones a la vez
CONCURRENCY=2

# Ruta a yt-dlp (respaldo para videos de X y Pinterest)
YTDLP_PATH=yt-dlp
# Nivel de logs de Baileys: silent | error | warn | info | debug
LOG_LEVEL=warn
# Mostrar en la consola cada foto/enlace que recibe el bot y qué hizo con él
LOG_MESSAGES=true
